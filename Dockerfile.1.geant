FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    build-essential cmake git wget curl \
    libexpat1-dev libxerces-c-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /tmp
RUN wget https://github.com/Geant4/geant4/archive/refs/tags/v11.3.2.tar.gz && \
    tar -xzf v11.3.2.tar.gz && \
    mkdir geant4-build && cd geant4-build && \
    cmake ../geant4-11.3.2 \
    -DCMAKE_INSTALL_PREFIX=/opt/geant4 \
    -DGEANT4_INSTALL_DATA=ON \
    -DGEANT4_BUILD_MULTITHREADED=ON \
    -DGEANT4_USE_QT=OFF \
    -DCMAKE_BUILD_TYPE=Release && \
    make -j$(nproc) && \
    make install && \
    cd /tmp && rm -rf geant4-11.3.2 v11.3.2.tar.gz geant4-build

ENV Geant4_DIR=/opt/geant4
ENV LD_LIBRARY_PATH=/opt/geant4/lib:$LD_LIBRARY_PATH
ENV PATH=/opt/geant4/bin:$PATH